{
  "initial_node": "finish",
  "system_prompt": "Inactive serializer diagnostics. End immediately. Do not call bank tools.",
  "global_nodes": {},
  "nodes": {
    "finish": {
      "name": "finish",
      "node_type": "end_call",
      "on_enter": {
        "type": "silent"
      },
      "disable_inactivity_monitor": true,
      "transitions": [],
      "terminal": {
        "type": "function",
        "function": {
          "name": "serializer_probe_end",
          "handler": "__function__:end_call",
          "parameters": {
            "type": "object",
            "properties": {
              "message_mode": {
                "type": "string",
                "default": "none"
              }
            }
          }
        }
      }
    },
    "code_probe": {
      "name": "code_probe",
      "node_type": "code",
      "on_enter": {
        "type": "silent"
      },
      "passthrough": true,
      "passthrough_default_transition": "finish",
      "pre_actions": [
        {
          "type": "function",
          "config": {
            "timeoutMs": 10000,
            "maxRetries": 0
          },
          "function": {
            "name": "code_exec",
            "handler": "__function__:code_exec",
            "parameters": {
              "type": "object",
              "properties": {
                "code": {
                  "type": "string",
                  "default": "vars['serializer_probe'] = 'ready'"
                },
                "timeout_ms": {
                  "type": "number",
                  "default": 10000
                }
              }
            }
          }
        }
      ],
      "transitions": [
        {
          "target_node": "finish",
          "description": "Always finish the inactive probe branch.",
          "condition": {
            "operator": "always"
          }
        }
      ]
    },
    "api_probe": {
      "name": "api_probe",
      "node_type": "api_request",
      "on_enter": {
        "type": "silent"
      },
      "passthrough": true,
      "passthrough_default_transition": "finish",
      "suppress_tool_results": true,
      "pre_actions": [
        {
          "type": "function",
          "config": {
            "timeoutMs": 10000,
            "maxRetries": 0
          },
          "function": {
            "name": "verify_identity",
            "handler": "__function__:api_call",
            "description": "Check one security answer. Three wrong answers in total end the check.",
            "parameters": {
              "type": "object",
              "properties": {
                "url": {
                  "type": "string",
                  "default": "https://freya-bank-mock.freyavoice.workers.dev/v1/verify_identity"
                },
                "method": {
                  "type": "string",
                  "default": "POST"
                },
                "connect_retries": {
                  "type": "number",
                  "default": 0
                },
                "headers": {
                  "type": "object",
                  "properties": {
                    "Content-Type": {
                      "type": "string",
                      "default": "application/json"
                    }
                  }
                },
                "body": {
                  "type": "object",
                  "properties": {
                    "customer_id": {
                      "type": "string",
                      "default": "{{customer_id}}"
                    },
                    "field": {
                      "type": "string",
                      "enum": [
                        "date_of_birth",
                        "phone_last4"
                      ],
                      "description": "Supply field from the verified conversation and permitted contract"
                    },
                    "answer": {
                      "type": "string",
                      "description": "For date_of_birth: the date as YYYY-MM-DD. Callers say dates in words, the agent converts. An unreadable value is rejected with ok=false and is not counted as a wrong answer. For phone_last4: four digits."
                    }
                  },
                  "required": [
                    "customer_id",
                    "field",
                    "answer"
                  ]
                }
              }
            }
          },
          "pre_process_code": "config = dict(config)",
          "post_process_code": "result = dict(result)"
        }
      ],
      "response_mapping": [
        {
          "path": "data.ok",
          "variable": "serializer_probe_ok"
        }
      ],
      "transitions": [
        {
          "target_node": "finish",
          "description": "Always finish the inactive probe branch.",
          "condition": {
            "operator": "always"
          }
        }
      ]
    }
  }
}
